{
  "name": "dsh-juzpost",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that connects the agent to JuzPost over MCP: list connected accounts, check platform limits, and draft, schedule or publish social media posts to YouTube, Instagram, Facebook, TikTok, X, LinkedIn, Pinterest, Bluesky, Threads, Tumblr and WordPress.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "juzpost",
    "mcp",
    "social-media",
    "social-media-scheduler",
    "scheduling",
    "automation"
  ],
  "author": {
    "name": "JuzPost",
    "email": "support@juzpost.com",
    "url": "https://www.juzpost.com"
  },
  "homepage": "https://github.com/juzpost/juzpost-claude-plugin/tree/main/plugins/dsh-juzpost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juzpost/juzpost-claude-plugin.git",
    "directory": "plugins/dsh-juzpost"
  },
  "bugs": {
    "url": "https://github.com/juzpost/juzpost-claude-plugin/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
